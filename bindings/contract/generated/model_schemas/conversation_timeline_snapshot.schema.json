{
  "$defs": {
    "AnnouncementElem": {
      "properties": {
        "body": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "pinned": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "body",
        "pinned",
        "metadata"
      ],
      "type": "object"
    },
    "AudioElem": {
      "properties": {
        "audioId": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioInfoElem"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "audioId",
        "description"
      ],
      "type": "object"
    },
    "AudioInfoElem": {
      "properties": {
        "durationMs": {
          "format": "int64",
          "type": "integer"
        },
        "mimeType": {
          "type": "string"
        },
        "size": {
          "format": "int64",
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "url",
        "mimeType",
        "size",
        "durationMs"
      ],
      "type": "object"
    },
    "CardElem": {
      "description": "与 `CardContent` 一致；JSON camelCase（如 `cardType`）",
      "properties": {
        "avatar": {
          "type": "string"
        },
        "cardType": {
          "default": "",
          "type": "string"
        },
        "extra": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "subtitle",
        "avatar"
      ],
      "type": "object"
    },
    "Conversation": {
      "description": "SDK 层会话类型：内部统一使用，从 proto ConversationSummary 获取后即转换为此类型。\n与 message.rs 的 IMMessage 一致：扁平字段、serde camelCase。",
      "properties": {
        "avatarUrl": {
          "default": "",
          "type": "string"
        },
        "badge": {
          "type": [
            "string",
            "null"
          ]
        },
        "businessType": {
          "default": "",
          "type": "string"
        },
        "channelId": {
          "default": "",
          "description": "会话路由 ID：单聊为对方 user_id；群/频道为业务 channel（与 proto `channel_id` 一致）",
          "type": "string"
        },
        "conversationId": {
          "default": "",
          "type": "string"
        },
        "conversationType": {
          "$ref": "#/$defs/ConversationType",
          "default": "unspecified"
        },
        "createdAt": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "default": "",
          "description": "展示名（列表主标题）",
          "type": "string"
        },
        "draft": {
          "type": [
            "string",
            "null"
          ]
        },
        "ext": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "扩展键值（与 proto ext 对应）",
          "type": "object"
        },
        "isArchived": {
          "default": false,
          "type": "boolean"
        },
        "isMuted": {
          "default": false,
          "type": "boolean"
        },
        "isPinned": {
          "default": false,
          "type": "boolean"
        },
        "lastMessage": {
          "anyOf": [
            {
              "$ref": "#/$defs/MessagePreviewElem"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastMessageAt": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lastMessageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastMessagePreview": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastReadSeq": {
          "default": 0,
          "description": "已读序列号（与 read_seq 同义）",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "lastSenderAvatarUrl": {
          "default": "",
          "description": "最后一条消息发送者头像 URL",
          "type": "string"
        },
        "lastSenderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastSenderNickname": {
          "default": "",
          "description": "最后一条消息发送者展示名（列表用）",
          "type": "string"
        },
        "maxSeq": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memberPreview": {
          "default": [],
          "description": "摘要级成员预览，最多少量成员，不能作为完整成员列表使用。",
          "items": {
            "$ref": "#/$defs/ConversationParticipant"
          },
          "type": "array"
        },
        "membersCount": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mentionCount": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mentionMe": {
          "default": false,
          "type": "boolean"
        },
        "participantVersion": {
          "default": 0,
          "description": "服务端成员读模型版本。完整成员通过独立 participants 同步拉取。",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "participants": {
          "default": [],
          "description": "已按需同步到本地的完整成员快照；会话摘要同步不会填充该字段。",
          "items": {
            "$ref": "#/$defs/ConversationParticipant"
          },
          "type": "array"
        },
        "peerReadSeq": {
          "default": 0,
          "description": "对端（其他成员）最大已读序列号；用于发送方已读双勾在重连/重登后恢复。\n由服务端同步摘要 `ext.peer_read_seq` 下发并持久化。",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "remark": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "unreadCount": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "updatedAt": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "updatedAtTs": {
          "description": "更新时间戳（毫秒，用于排序/筛选）",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "version": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "visibleAfterSeq": {
          "default": 0,
          "description": "当前用户的历史可见边界；seq <= visible_after_seq 的消息不可见，不参与冷启动回灌。",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ConversationParticipant": {
      "description": "SDK 本地会话参与者快照。单聊不依赖该结构；群聊/频道/客服等非单聊用它支撑群通话、成员面板和后续设置页。",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "joinedAt": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "muted": {
          "default": false,
          "type": "boolean"
        },
        "nickname": {
          "default": "",
          "type": "string"
        },
        "pinned": {
          "default": false,
          "type": "boolean"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "userId": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ConversationType": {
      "enum": [
        "unspecified",
        "single",
        "group",
        "ai",
        "system",
        "customer",
        "temp",
        "channel",
        "broadcast"
      ],
      "type": "string"
    },
    "CustomElem": {
      "properties": {
        "description": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "payload": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "description",
        "metadata"
      ],
      "type": "object"
    },
    "Elem": {
      "description": "解码后的消息内容枚举；JSON 为 `#[serde(tag = \"contentType\", rename_all = \"snake_case\")]`。",
      "oneOf": [
        {
          "$ref": "#/$defs/TextElem",
          "properties": {
            "contentType": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ImageElem",
          "properties": {
            "contentType": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/VideoElem",
          "properties": {
            "contentType": {
              "const": "video",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AudioElem",
          "properties": {
            "contentType": {
              "const": "audio",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/FileElem",
          "properties": {
            "contentType": {
              "const": "file",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/LocationElem",
          "properties": {
            "contentType": {
              "const": "location",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/CardElem",
          "properties": {
            "contentType": {
              "const": "card",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/StickerElem",
          "properties": {
            "contentType": {
              "const": "sticker",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/EmojiElem",
          "properties": {
            "contentType": {
              "const": "emoji",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/QuoteElem",
          "properties": {
            "contentType": {
              "const": "quote",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/LinkCardElem",
          "properties": {
            "contentType": {
              "const": "link_card",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ForwardElem",
          "properties": {
            "contentType": {
              "const": "forward",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ThreadElem",
          "properties": {
            "contentType": {
              "const": "thread",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/MiniProgramElem",
          "properties": {
            "contentType": {
              "const": "mini_program",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/RichTextElem",
          "properties": {
            "contentType": {
              "const": "rich_text",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ImageGroupElem",
          "properties": {
            "contentType": {
              "const": "image_group",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/SystemElem",
          "properties": {
            "contentType": {
              "const": "system",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/NotificationElem",
          "properties": {
            "contentType": {
              "const": "notification",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/VoteElem",
          "properties": {
            "contentType": {
              "const": "vote",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/TaskElem",
          "properties": {
            "contentType": {
              "const": "task",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ScheduleElem",
          "properties": {
            "contentType": {
              "const": "schedule",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AnnouncementElem",
          "properties": {
            "contentType": {
              "const": "announcement",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/CustomElem",
          "properties": {
            "contentType": {
              "const": "custom",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/PlaceholderElem",
          "properties": {
            "contentType": {
              "const": "placeholder",
              "type": "string"
            }
          },
          "required": [
            "contentType"
          ],
          "type": "object"
        }
      ]
    },
    "EmojiElem": {
      "properties": {
        "description": {
          "type": "string"
        },
        "emoji": {
          "type": "string"
        },
        "extra": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "emoji",
        "description",
        "extra"
      ],
      "type": "object"
    },
    "FileElem": {
      "properties": {
        "description": {
          "type": "string"
        },
        "fileId": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "fileSize": {
          "format": "int64",
          "type": "integer"
        },
        "mimeType": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "fileId",
        "fileName",
        "mimeType",
        "fileSize",
        "url",
        "description"
      ],
      "type": "object"
    },
    "ForwardElem": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ForwardItemElem"
          },
          "type": "array"
        },
        "mode": {
          "description": "`ForwardMode` 枚举值（与 proto 一致）",
          "format": "int32",
          "type": "integer"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "items"
      ],
      "type": "object"
    },
    "ForwardItemElem": {
      "properties": {
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/Elem"
            },
            {
              "type": "null"
            }
          ]
        },
        "messageType": {
          "format": "int32",
          "type": "integer"
        },
        "plainText": {
          "type": "string"
        },
        "sourceConversationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceMessageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceMessageTimeMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sourceSenderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceSenderName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "messageType",
        "plainText"
      ],
      "type": "object"
    },
    "IMMessage": {
      "description": "SDK 层消息类型：与 message.proto 的 Message 属性一致，content 为解码后的 Elem；\n另保留 raw_content 与 proto 一致用于持久化/网络，并增加发送者展示字段。",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "channelId": {
          "description": "会话频道 ID：单聊=对方 user_id，群聊=群 ID，频道/话题=对应 ID",
          "type": "string"
        },
        "clientCreatedAt": {
          "description": "客户端本地创建时间，Unix epoch millis。",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "clientMsgId": {
          "description": "客户端生成ID（去重）",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/Elem"
            },
            {
              "type": "null"
            }
          ],
          "description": "proto结构"
        },
        "conversationId": {
          "description": "会话ID",
          "type": "string"
        },
        "conversationSeq": {
          "description": "会话内持久化 replay 序列号。",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "conversationType": {
          "description": "会话类型",
          "format": "int32",
          "type": "integer"
        },
        "createdAt": {
          "description": "消息创建时间，Unix epoch millis。",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "extensions": {
          "additionalProperties": {
            "items": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "default": {},
          "description": "扩展数据；未提供时为空。",
          "type": "object"
        },
        "isEdited": {
          "type": "boolean"
        },
        "isRead": {
          "type": "boolean"
        },
        "isRecalled": {
          "type": "boolean"
        },
        "localState": {
          "$ref": "#/$defs/MessageLocalState",
          "default": {
            "failed": false,
            "isLocal": false,
            "sending": false,
            "sortTs": 0,
            "uploadProgress": 0,
            "uploading": false
          }
        },
        "mentionAll": {
          "type": "boolean"
        },
        "mentionUsers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "messageType": {
          "description": "消息类型",
          "format": "int32",
          "type": "integer"
        },
        "quotePreview": {
          "type": [
            "string",
            "null"
          ]
        },
        "reactions": {
          "default": [],
          "description": "表情反应快照（由 ReactionEvent 驱动更新并持久化）",
          "items": {
            "$ref": "#/$defs/ReactionEntry"
          },
          "type": "array"
        },
        "replyTo": {
          "type": [
            "string",
            "null"
          ]
        },
        "senderAvatar": {
          "type": "string"
        },
        "senderDisplayName": {
          "description": "SDK计算展示名",
          "type": "string"
        },
        "senderId": {
          "description": "发送者",
          "type": "string"
        },
        "senderName": {
          "type": "string"
        },
        "serverId": {
          "description": "服务端唯一ID",
          "type": "string"
        },
        "source": {
          "description": "消息来源",
          "format": "int32",
          "type": "integer"
        },
        "status": {
          "format": "int32",
          "type": "integer"
        },
        "textPreview": {
          "default": "",
          "description": "列表、搜索、绑定层使用的纯文本预览。",
