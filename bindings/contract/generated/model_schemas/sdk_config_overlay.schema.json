    "SdkResourceProfile": {
      "description": "Runtime resource budget selected by the host app.\n\nThe profile only supplies defaults. Explicit numeric config fields still win,\nso production apps can tune one knob without forking the whole profile.",
      "oneOf": [
        {
          "const": "desktop",
          "description": "Balanced defaults for desktop and server-like hosts.",
          "type": "string"
        },
        {
          "const": "mobile",
          "description": "Conservative defaults for mobile devices and memory-constrained hosts.",
          "type": "string"
        }
      ]
    },
    "TransportKind": {
