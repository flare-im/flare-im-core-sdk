{
  "schemaVersion": 1,
  "description": "Canonical init/login config shapes for all bindings (snake_case JSON).",
  "initRequest": {
    "fields": {
      "environment": { "type": "string", "optional": true },
      "sdk_config": { "type": "SdkConfigOverlay", "optional": true }
    },
    "example": {
      "environment": "production",
      "sdk_config": {
        "ws_url": "ws://localhost:60051",
        "quic_url": "quic://localhost:60052",
        "http_url": "http://localhost:50050",
        "transport_policy": "protocol_race",
        "default_transport": "websocket",
        "protocol_race_order": ["quic", "websocket"],
        "connect_timeout_secs": 30,
        "reconnect_interval_secs": 5
      }
    }
  },
  "sdkConfigOverlay": {
    "transportPolicy": {
      "type": "enum",
      "values": ["auto", "websocket_only", "protocol_race"],
      "wasmEffective": "websocket_only"
    },
    "defaultTransport": {
      "type": "enum",
      "values": ["websocket", "quic"],
      "description": "非竞速时的首选传输；未设置时以 WebSocket 为主入口。"
    },
    "protocolRaceOrder": {
      "type": "array",
      "items": ["websocket", "quic"],
      "description": "协议竞速优先级（前项优先）。需同时提供 ws_url 与 quic_url，且 transport_policy 为 auto 或 protocol_race。"
    },
    "urls": ["data_url", "ws_url", "quic_url", "http_url", "capability_url", "online_url"],
    "tenant": ["tenant_id"],
    "timeouts": [
      "connect_timeout_secs",
      "reconnect_interval_secs",
      "max_reconnect_attempts",
      "ack_timeout_secs",
      "ack_max_retries"
    ],
    "sync": ["sync_batch_size", "init_message_sync_concurrency"],
    "flags": ["enable_metrics"]
  },
  "platformNotes": {
    "c": "flare_sdk_init(handle, config_json, ...) — UTF-8 JSON 即 SdkConfigOverlay 或 initRequest 包装",
    "tauri": "sdk_init({ environment?, sdk_config? }) — 字段与 initRequest 一致",
    "wasm": "flareInvoke(runtime, \"client.init\", initRequestJson) — smoke 与生产适配器同形",
    "uniffi": "invoke_contract_api(\"client.init\", initRequestJson)"
  }
}
