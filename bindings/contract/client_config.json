{
  "schemaVersion": 1,
  "description": "Canonical init/login config shapes for all bindings (camelCase SDK JSON).",
  "initRequest": {
    "fields": {
      "environment": {
        "type": "string",
        "optional": true
      },
      "sdkConfig": {
        "type": "SdkConfigOverlay",
        "optional": true
      }
    },
    "example": {
      "environment": "production",
      "sdkConfig": {
        "wsUrl": "ws://localhost:60051",
        "quicUrl": "quic://localhost:60052",
        "httpUrl": "http://localhost:50050",
        "transportPolicy": "protocol_race",
        "defaultTransport": "websocket",
        "protocolRaceOrder": [
          "quic",
          "websocket"
        ],
        "tlsCaCertPath": "certs/server.crt",
        "connectTimeoutSecs": 30,
        "reconnectIntervalSecs": 5,
        "auth": {
          "tokenEndpoint": "http://localhost:50050"
        }
      }
    }
  },
  "sdkConfigOverlay": {
    "transportPolicy": {
      "type": "enum",
      "values": [
        "auto",
        "websocket_only",
        "protocol_race"
      ],
      "wasmEffective": "websocket_only"
    },
    "defaultTransport": {
      "type": "enum",
      "values": [
        "websocket",
        "quic"
      ],
      "description": "非竞速时的首选传输；未设置时以 WebSocket 为主入口。"
    },
    "protocolRaceOrder": {
      "type": "array",
      "items": [
        "websocket",
        "quic"
      ],
      "description": "协议竞速优先级（前项优先）。需同时提供 wsUrl 与 quicUrl，且 transportPolicy 为 auto 或 protocol_race。"
    },
    "urls": [
      "dataUrl",
      "wsUrl",
      "quicUrl",
      "httpUrl",
      "capabilityUrl",
      "onlineUrl"
    ],
    "tenant": [
      "tenantId"
    ],
    "device": [
      "deviceId"
    ],
    "timeouts": [
      "connectTimeoutSecs",
      "reconnectIntervalSecs",
      "maxReconnectAttempts",
      "ackTimeoutSecs",
      "ackMaxRetries"
    ],
    "sync": [
      "syncBatchSize",
      "initMessageSyncConcurrency"
    ],
    "tls": [
      "tlsCaCertPath",
      "tlsCaCert",
      "tlsSpkiSha256Pins",
      "tlsCertificateSha256Pins"
    ],
    "flags": [
      "enableMetrics"
    ],
    "auth": {
      "type": "object",
      "fields": {
        "tokenEndpoint": {
          "type": "string",
          "optional": true
        },
        "refreshLeadSecs": {
          "type": "u64",
          "optional": true
        }
      },
      "description": "接入 token 来源。tokenEndpoint 配了即 SDK 托管：login 不传 token 时向 {tokenEndpoint}/api/v1/auth/tokens 签发，到期前 refreshLeadSecs（默认 300）秒用 /api/v1/auth/tokens/refresh 换新。没配则必须显式传 token（flare-social / 自建业务由应用拿 token、自己刷新）。客户端永远不持有签名密钥。"
    },
    "tlsCaCert": {
      "type": "string",
      "optional": true,
      "description": "内联信任 CA 证书（PEM 文本或 base64 DER）。移动端没有可靠文件路径时用它代替 tlsCaCertPath；QUIC/wss 连自签/私有 CA 的服务端必配。"
    }
  },
  "platformNotes": {
    "c": "flare_sdk_init(handle, config_json, ...) — UTF-8 JSON 即 SdkConfigOverlay 或 initRequest 包装",
    "tauri": "sdk_init({ environment?, sdkConfig? }) — 字段与 initRequest 一致",
    "wasm": "flareInvoke(runtime, \"client.init\", initRequestJson) — smoke 与生产适配器同形",
    "uniffi": "invoke_contract_api(\"client.init\", initRequestJson)"
  }
}
