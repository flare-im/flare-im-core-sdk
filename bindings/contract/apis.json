{
  "schemaVersion": 1,
  "apiContractVersion": "flare-im-api/v1",
  "rules": [
    "Canonical API ids are singular dot-separated operation ids matching the Rust binding runtime route.",
    "C direct functions are preferred for hot lifecycle, media, and simple message paths; conversation APIs use the canonical contract invoke boundary.",
    "C JSON dispatch is used for large or fast-evolving request shapes.",
    "Tauri commands mirror the same canonical ids but use command names prefixed with sdk_.",
    "Bindings must not implement business rules; they only validate boundary inputs and forward to core APIs.",
    "All complex C payloads are UTF-8 JSON with camelCase SDK wire fields."
  ],
  "cAbi": {
    "asyncReturn": "i32 immediate_submit_code",
    "callback": "FlareResultCallback",
    "jsonDispatch": {
      "message": "flare_message_dispatch_json(handle, op, params_json, context, callback)",
      "messageBuild": "flare_message_build_json(handle, request_json, context, callback)",
      "media": "flare_media_dispatch_json(handle, op, params_json, context, callback)"
    }
  },
