{
  "schemaVersion": 1,
  "eventContractVersion": "flare-im-events/v1",
  "rules": [
    "Rust core SdkEvent is the source of truth.",
    "C ABI event_json uses snake_case fields and always includes type and event.",
    "C ABI event_type is stable and must be used for fast native dispatch.",
    "Tauri emits im://* names and snake_case payloads.",
    "Notification events are separate from chat message events.",
    "Extension payload bytes are opaque and interpreted by the owning extension."
  ],
  "cAbi": {
    "subscribe": "flare_event_subscribe(handle, context, callback)",
    "unsubscribe": "flare_event_unsubscribe(subscription)",
    "callback": "extern C fn(context, event_type: i32, event_json: FlareString)",
    "codeRanges": {
      "connection": "1001-1999",
      "message": "2001-2999",
      "conversation": "3001-3499",
      "notification": "3501-3999",
      "sync": "4001-4999",
      "extension": "5001-5999"
    }
  },
  "events": [
